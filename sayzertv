function budget(): float {
    return max(1.0, 27.0 - (microtime(true) - STREAM_STARTED_AT));
}

function is_public_http_url(string $url): bool {
    if ($url === '' || filter_var($url, FILTER_VALIDATE_URL) === false) {
        return false;
    }
    $parts = parse_url($url);
    if (!is_array($parts)) {
        return false;
    }
    $scheme = strtolower((string) ($parts['scheme'] ?? ''));
    $host = strtolower((string) ($parts['host'] ?? ''));
    if (!in_array($scheme, ['http', 'https'], true) || $host === '') {
        return false;
    }
    if ($host === 'localhost' || str_ends_with($host, '.local') || str_ends_with($host, '.internal')) {
        return false;
    }
    $cleanHost = trim($host, '[]');
    if (filter_var($cleanHost, FILTER_VALIDATE_IP) !== false) {
        return filter_var(
            $cleanHost,
            FILTER_VALIDATE_IP,
            FILTER_FLAG_NO_PRIV_RANGE | FILTER_FLAG_NO_RES_RANGE
        ) !== false;
    }
    return true;
}

/* ---------------- Cache + Single-Flight + SWR ---------------- */
function cache_dir(): ?string {
    static $dir = null;
    if ($dir !== null) {
        return $dir === false ? null : $dir;
    }

    if (!is_dir(CACHE_DIR) && !@mkdir(CACHE_DIR, 0700, true)) {
        $dir = false;
        return null;
    }

    if (!is_writable(CACHE_DIR)) {
        $dir = false;
        return null;
    }

    $htaccess = CACHE_DIR . '/.htaccess';
    if (!is_file($htaccess)) {
        @file_put_contents($htaccess, "Require all denied\nDeny from all\n");
    }

    $index = CACHE_DIR . '/index.php';
    if (!is_file($index)) {
        @file_put_contents($index, "<?php http_response_code(403); exit;\n");
    }

    $dir = CACHE_DIR;
    return $dir;
}

function cache_path(string $key): ?string {
    $dir = cache_dir();
    return $dir === null ? null : $dir . '/' . hash('sha256', $key) . '.cache';
}

function lock_path(string $key): ?string {
    $dir = cache_dir();
    return $dir === null ? null : $dir . '/' . hash('sha256', $key) . '.lock';
}

function cache_read_entry(string $key): ?array {
    $path = cache_path($key);
    if ($path === null || !is_file($path)) {
        return null;
    }

    $raw = @file_get_contents($path);
    if (!is_string($raw) || $raw === '') {
        return null;
    }

    $data = json_decode($raw, true);
    if (!is_array($data) || !isset($data['t']) || !array_key_exists('v', $data)) {
        return null;
    }

    return [
        't' => (int) $data['t'],
        'ttl' => isset($data['ttl']) ? (int) $data['ttl'] : null,
        'v' => $data['v'],
    ];
}

function cache_read(string $key, int $ttl): mixed {
    $entry = cache_read_entry($key);
    if ($entry === null) {
        return null;
    }

    $effectiveTtl = $entry['ttl'] ?? $ttl;
    if (time() - $entry['t'] >= $effectiveTtl) {
        return null;
    }

    return $entry['v'];
}

function cache_write(string $key, mixed $value, ?int $customTtl = null): void {
    $path = cache_path($key);
    if ($path === null) {
        return;
    }

    $payload = ['t' => time(), 'v' => $value];
    if ($customTtl !== null) {
        $payload['ttl'] = $customTtl;
    }

    $json = json_encode($payload, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
    if ($json === false) {
        return;
    }

    $tmp = $path . '.' . bin2hex(random_bytes(4)) . '.tmp';
    if (@file_put_contents($tmp, $json, LOCK_EX) !== false) {
        if (!@rename($tmp, $path)) {
            @unlink($tmp);
        }
    }
}

function cache_delete(string $key): void {
    $path = cache_path($key);
    if ($path !== null && is_file($path)) {
        @unlink($path);
    }
}

function cache_fetch_swr(
    string $key,
    int $freshTtl,
    int $staleTtl,
    callable $loader,
    bool $forceRefresh = false,
    int $minForceInterval = 2
): mixed {
    $now = time();
    $entry = cache_read_entry($key);

    if ($entry !== null) {
        $age = $now - $entry['t'];
        $effectiveFresh = $entry['ttl'] ?? $freshTtl;

        if (!$forceRefresh && $age < $effectiveFresh) {
            return $entry['v'];
        }
        if ($forceRefresh && $age < $minForceInterval) {
            return $entry['v'];
        }
    }

    $hasStale = $entry !== null && ($now - $entry['t']) < $staleTtl;
    $lockFile = lock_path($key);

    if ($lockFile === null) {
        $fresh = $loader();
        return is_array($fresh) && array_key_exists('__value', $fresh) ? $fresh['__value'] : $fresh;
    }

    $fp = @fopen($lockFile, 'c+');
    if ($fp === false) {
        if ($hasStale && !$forceRefresh) {
            return $entry['v'];
        }
        $fresh = $loader();
        return is_array($fresh) && array_key_exists('__value', $fresh) ? $fresh['__value'] : $fresh;
    }

    $gotLock = @flock($fp, LOCK_EX | LOCK_NB);

    if (!$gotLock) {
        if ($hasStale && !$forceRefresh) {
            @fclose($fp);
            return $entry['v'];
        }

        $deadline = microtime(true) + min(LOCK_WAIT_TIMEOUT, max(1.0, budget() - 1.0));
        while (!$gotLock && microtime(true) < $deadline) {
            usleep(50000);
            $recheck = cache_read_entry($key);
            if ($recheck !== null) {
                $recheckAge = time() - $recheck['t'];
                $recheckTtl = $recheck['ttl'] ?? $freshTtl;
                if ((!$forceRefresh && $recheckAge < $recheckTtl) || ($forceRefresh && $recheckAge < $minForceInterval)) {
                    @fclose($fp);
                    return $recheck['v'];
                }
            }
            $gotLock = @flock($fp, LOCK_EX | LOCK_NB);
        }

        if (!$gotLock) {
            @fclose($fp);
            if ($hasStale) {
                return $entry['v'];
            }
            throw new RuntimeException('Yayın hazırlanıyor, tekrar deneniyor.');
        }
    }

    $recheck = cache_read_entry($key);
    if ($recheck !== null) {
        $recheckAge = time() - $recheck['t'];
        $recheckTtl = $recheck['ttl'] ?? $freshTtl;
        if ((!$forceRefresh && $recheckAge < $recheckTtl) || ($forceRefresh && $recheckAge < $minForceInterval)) {
            @flock($fp, LOCK_UN);
            @fclose($fp);
            return $recheck['v'];
        }
    }

    try {
        $fresh = $loader();
        $customTtl = null;
        $value = $fresh;

        if (is_array($fresh) && array_key_exists('__value', $fresh)) {
            $value = $fresh['__value'];
            $customTtl = isset($fresh['__ttl']) ? (int) $fresh['__ttl'] : null;
        }

        cache_write($key, $value, $customTtl);
        return $value;
    } catch (Throwable $ex) {
        if ($hasStale && !$forceRefresh) {
            return $entry['v'];
        }
        throw $ex;
    } finally {
        @flock($fp, LOCK_UN);
        @fclose($fp);
    }
}

function cache_gc(): void {
    try {
        if (random_int(1, CACHE_GC_PROBABILITY) !== 1) {
            return;
        }
    } catch (Throwable) {
        return;
    }

    $dir = cache_dir();
    if ($dir === null) {
        return;
    }

    $now = time();
    $files = @glob($dir . '/*');
    if (!is_array($files)) {
        return;
    }

    foreach ($files as $file) {
        if (!is_file($file)) {
            continue;
        }
        $base = basename($file);
        if ($base === '.htaccess' || $base === 'index.php' || $base === '.secret') {
            continue;
        }
        $mtime = @filemtime($file);
        if ($mtime === false) {
            continue;
        }
        $age = $now - $mtime;

        if (str_ends_with($base, '.tmp') && $age > 120) {
            @unlink($file);
            continue;
        }

        if (str_ends_with($base, '.lock') && $age > CACHE_GC_LOCK_TTL) {
            $fp = @fopen($file, 'c+');
            if ($fp !== false) {
                if (@flock($fp, LOCK_EX | LOCK_NB)) {
                    @unlink($file);
                    @flock($fp, LOCK_UN);
                }
                @fclose($fp);
            }
            continue;
        }

        if (str_ends_with($base, '.cache') && $age > CACHE_GC_SHORT_TTL) {
            $raw = @file_get_contents($file);
            if (!is_string($raw) || $raw === '') {
                @unlink($file);
                continue;
            }
            $data = json_decode($raw, true);
            if (!is_array($data)) {
                @unlink($file);
                continue;
            }
            $entryTtl = isset($data['ttl']) ? (int) $data['ttl'] : null;
            if ($entryTtl !== null && $entryTtl <= 300 && $age > max(1800, $entryTtl * 20)) {
                @unlink($file);
            } elseif ($age > 1209600) {
                @unlink($file);
            }
        }
    }
}

/* ---------------- İmza / Player Token ---------------- */
function app_secret(): string {
    static $secret = null;
    if ($secret !== null) {
        return $secret;
    }

    $dir = cache_dir();
    if ($dir !== null) {
        $path = $dir . '/.secret';
        if (is_file($path)) {
            $raw = trim((string) @file_get_contents($path));
            if (strlen($raw) >= 32) {
                $secret = $raw;
                return $secret;
            }
        }
        $generated = bin2hex(random_bytes(32));
        if (@file_put_contents($path, $generated, LOCK_EX) !== false) {
            @chmod($path, 0600);
            $secret = $generated;
            return $secret;
        }
    }

    $secret = hash('sha256', __FILE__ . '|' . php_uname('n'));
    return $secret;
}

function sign_sub_url(string $id, string $url): string {
    return hash_hmac('sha256', $id . '|' . $url, app_secret());
}

function create_player_token(string $id): string {
    $exp = time() + PLAYER_TOKEN_TTL;
    $sig = hash_hmac('sha256', 'pt|' . $id . '|' . $exp, app_secret());
    return $exp . '.' . $sig;
}

function verify_player_token(string $id, string $token): bool {
    if ($token === '' || !str_contains($token, '.')) {
        return false;
    }
    [$expStr, $sig] = explode('.', $token, 2);
    if (!ctype_digit($expStr) || $sig === '') {
        return false;
    }
    if ((int) $expStr < time()) {
        return false;
    }
    $expected = hash_hmac('sha256', 'pt|' . $id . '|' . $expStr, app_secret());
    return hash_equals($expected, $sig);
}

/* ---------------- HTTP & Cloudflare Algılama ---------------- */
function apply_curl_proxy($ch): void {
    if (UPSTREAM_PROXY !== '') {
        curl_setopt($ch, CURLOPT_PROXY, UPSTREAM_PROXY);
    }
}

function is_cloudflare_challenge(int $status, string $body, array $headers = []): bool {
    $cfMitigated = strtolower((string) ($headers['cf-mitigated'] ?? ''));
    if ($cfMitigated === 'challenge') {
        return true;
    }
    if (!in_array($status, [403, 503], true)) {
        return false;
    }
    return str_contains($body, 'Just a moment')
        || str_contains($body, 'cf-browser-verification')
        || str_contains($body, 'challenge-platform')
        || str_contains($body, '_cf_chl_opt')
        || str_contains($body, 'Attention Required! | Cloudflare');
}

function post_json(
    string $url,
    array $payload,
    array $headers = [],
    ?int $maxTimeout = null,
    ?string $userAgent = null
): array {
    $limit = $maxTimeout ?? REQUEST_TIMEOUT;
    $attempts = 2;
    $lastException = null;
    $ua = $userAgent ?? API_USER_AGENTS[0];

    for ($attempt = 0; $attempt < $attempts; $attempt++) {
        $timeout = max(1, min($limit, (int) floor(budget())));
        if ($timeout <= 1 && $attempt > 0) {
            break;
        }

        $ch = curl_init($url);
        if ($ch === false) {
            throw new RuntimeException('cURL başlatılamadı.');
        }

        $respHeaders = [];
        curl_setopt_array($ch, [
            CURLOPT_POST => true,
            CURLOPT_POSTFIELDS => json_encode(
                $payload,
                JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR
            ),
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_FOLLOWLOCATION => false,
            CURLOPT_CONNECTTIMEOUT => min(4, $timeout),
            CURLOPT_TIMEOUT => $timeout,
            CURLOPT_SSL_VERIFYPEER => true,
            CURLOPT_SSL_VERIFYHOST => 2,
            CURLOPT_PROTOCOLS => CURLPROTO_HTTPS,
            CURLOPT_ENCODING => '',
            CURLOPT_TCP_KEEPALIVE => 1,
            CURLOPT_USERAGENT => $ua,
            CURLOPT_HTTPHEADER => array_merge([
                'Content-Type: application/json; charset=utf-8',
                'Accept: application/json',
                'Connection: keep-alive',
            ], $headers),
            CURLOPT_HEADERFUNCTION => static function ($curl, string $headerLine) use (&$respHeaders): int {
                $pos = strpos($headerLine, ':');
                if ($pos !== false) {
                    $k = strtolower(trim(substr($headerLine, 0, $pos)));
                    $v = trim(substr($headerLine, $pos + 1));
                    $respHeaders[$k] = $v;
                }
                return strlen($headerLine);
            },
        ]);
        apply_curl_proxy($ch);

        $body = curl_exec($ch);
        $status = (int) curl_getinfo($ch, CURLINFO_HTTP_CODE);
        $error = curl_error($ch);
        $errno = curl_errno($ch);
        curl_close($ch);

        if ($body === false) {
            $lastException = new RuntimeException('cURL ' . $errno . ': ' . $error);
            if ($attempt === 0 && budget() > 4.0) {
                usleep(120000);
                continue;
            }
            throw $lastException;
        }

        $bodyStr = (string) $body;
        if (
            $attempt === 0
            && !is_cloudflare_challenge($status, $bodyStr, $respHeaders)
            && ($status === 429 || $status >= 500)
            && budget() > 4.0
        ) {
            usleep(150000);
            continue;
        }

        return [
            'status' => $status,
            'json' => json_decode($bodyStr, true),
            'body' => $bodyStr,
            'headers' => $respHeaders,
        ];
    }

    throw $lastException ?? new RuntimeException('HTTP POST başarısız.');
}

function post_json_multi(array $requests): array {
    if ($requests === []) {
        return [];
    }

    $mh = curl_multi_init();
    $handles = [];
    $timeout = max(2, min(REQUEST_TIMEOUT, (int) floor(budget())));

    foreach ($requests as $key => $req) {
        $ch = curl_init($req['url']);
        if ($ch === false) {
            continue;
        }
        curl_setopt_array($ch, [
            CURLOPT_POST => true,
            CURLOPT_POSTFIELDS => json_encode(
                $req['payload'],
                JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR
            ),
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_FOLLOWLOCATION => false,
            CURLOPT_CONNECTTIMEOUT => min(4, $timeout),
            CURLOPT_TIMEOUT => $timeout,
            CURLOPT_SSL_VERIFYPEER => true,
            CURLOPT_SSL_VERIFYHOST => 2,
            CURLOPT_PROTOCOLS => CURLPROTO_HTTPS,
            CURLOPT_ENCODING => '',
            CURLOPT_TCP_KEEPALIVE => 1,
            CURLOPT_USERAGENT => $req['ua'] ?? API_USER_AGENTS[0],
            CURLOPT_HTTPHEADER => array_merge([
                'Content-Type: application/json; charset=utf-8',
                'Accept: application/json',
                'Connection: keep-alive',
            ], $req['headers'] ?? []),
        ]);
        apply_curl_proxy($ch);
        curl_multi_add_handle($mh, $ch);
        $handles[$key] = $ch;
    }

    $running = null;
    do {
        $status = curl_multi_exec($mh, $running);
        if ($running > 0) {
            curl_multi_select($mh, 0.2);
        }
    } while ($running > 0 && $status === CURLM_OK);

    $results = [];
    foreach ($handles as $key => $ch) {
        $body = curl_multi_getcontent($ch);
        $httpCode = (int) curl_getinfo($ch, CURLINFO_HTTP_CODE);
        $error = curl_error($ch);
        $bodyStr = is_string($body) ? $body : '';
        $results[$key] = [
            'status' => $httpCode,
            'json' => $bodyStr !== '' ? json_decode($bodyStr, true) : null,
            'body' => $bodyStr,
            'error' => $error,
        ];
        curl_multi_remove_handle($mh, $ch);
        curl_close($ch);
    }

    curl_multi_close($mh);
    return $results;
}

function get_text(string $url, array $headers = []): array {
    $currentUrl = str_replace(' ', '%20', $url);

    for ($redir = 0; $redir <= 5; $redir++) {
        $currentUrl = str_replace(' ', '%20', $currentUrl);
        if (!is_public_http_url($currentUrl)) {
            throw new RuntimeException('Geçersiz veya güvenli olmayan upstream adresi.');
        }

        $timeout = max(1, min(PLAYLIST_TIMEOUT, (int) floor(budget())));
        $ch = curl_init($currentUrl);
        if ($ch === false) {
            throw new RuntimeException('cURL başlatılamadı.');
        }

        $redirectLocation = null;
        curl_setopt_array($ch, [
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_FOLLOWLOCATION => false,
            CURLOPT_CONNECTTIMEOUT => min(4, $timeout),
            CURLOPT_TIMEOUT => $timeout,
            CURLOPT_SSL_VERIFYPEER => true,
            CURLOPT_SSL_VERIFYHOST => 2,
            CURLOPT_PROTOCOLS => CURLPROTO_HTTPS | CURLPROTO_HTTP,
            CURLOPT_ENCODING => '',
            CURLOPT_TCP_KEEPALIVE => 1,
            CURLOPT_USERAGENT => HLS_UA,
            CURLOPT_HTTPHEADER => $headers,
            CURLOPT_HEADERFUNCTION => static function ($curl, string $headerLine) use (&$redirectLocation): int {
                if (stripos($headerLine, 'Location:') === 0) {
                    $redirectLocation = trim(substr($headerLine, 9));
                }
                return strlen($headerLine);
            },
        ]);
        apply_curl_proxy($ch);

        $body = curl_exec($ch);
        $status = (int) curl_getinfo($ch, CURLINFO_HTTP_CODE);
        $error = curl_error($ch);
        curl_close($ch);

        if ($body === false) {
            throw new RuntimeException('Playlist alınamadı: ' . $error);
        }

        if (in_array($status, [301, 302, 303, 307, 308], true) && is_string($redirectLocation) && $redirectLocation !== '') {
            $currentUrl = absolute_url($currentUrl, $redirectLocation);
            continue;
        }

        return [
            'status' => $status,
            'body' => (string) $body,
            'final_url' => $currentUrl,
        ];
    }

    throw new RuntimeException('Çok fazla yönlendirme.');
}

/* ---------------- İmza & Çalışan Profil Yönetimi ---------------- */
function build_ping_payload(): array {
    $time = (int) round(microtime(true) * 1000);
    $deviceId = cache_read('device_uid', 21600);
    if (!is_string($deviceId) || !preg_match('/^[a-f0-9]{32}$/', $deviceId)) {
        $deviceId = bin2hex(random_bytes(16));
        cache_write('device_uid', $deviceId, 21600);
    }

    return [
        'reason' => 'app-focus',
        'locale' => 'de',
        'theme' => 'dark',
        'metadata' => [
            'device' => [
                'type' => 'desktop',
                'uniqueId' => $deviceId,
            ],
            'os' => [
                'name' => 'win32',
                'version' => 'Windows 10 Pro',
                'abis' => ['x64'],
                'host' => 'PC',
            ],
            'app' => ['platform' => 'electron'],
            'version' => [
                'package' => 'net.vypn.app',
                'binary' => PING_APP_VERSION,
                'js' => PING_APP_VERSION,
            ],
        ],
        'appFocusTime' => 0,
        'playerActive' => false,
        'playDuration' => 0,
        'devMode' => false,
        'hasAddon' => true,
        'castConnected' => false,
        'package' => 'net.vypn.app',
        'version' => PING_APP_VERSION,
        'process' => 'app',
        'firstAppStart' => $time,
        'lastAppStart' => $time,
        'ipLocation' => null,
        'adblockEnabled' => true,
        'proxy' => [
            'supported' => ['ss'],
            'engine' => 'Mu',
            'enabled' => false,
            'autoServer' => true,
        ],
        'iap' => ['supported' => false],
    ];
}

function fetch_signature_upstream(): string {
    $payload = build_ping_payload();
    $urls = PING_URLS;
    $lastGood = cache_read('last_good_ping', 3600);
    if (is_string($lastGood) && in_array($lastGood, $urls, true)) {
        $urls = array_values(array_unique(array_merge([$lastGood], $urls)));
    }

    $pingUas = [API_USER_AGENTS[0], UA];
    $lastError = 'İmza alınamadı.';

    foreach ($urls as $url) {
        foreach ($pingUas as $pingUa) {
            if (budget() < 2.0) {
                break 2;
            }
            try {
                $response = post_json($url, $payload, [], PING_TIMEOUT, $pingUa);
                if ($response['status'] < 200 || $response['status'] >= 300) {
                    $lastError = 'Ping HTTP ' . $response['status'] . ' (' . parse_url($url, PHP_URL_HOST) . ')';
                    continue;
                }
                $data = $response['json'];
                if (!is_array($data)) {
                    $lastError = 'Ping JSON yok';
                    continue;
                }
                foreach (['sig', 'addonSig', 'signature', 'token'] as $key) {
                    $value = $data[$key] ?? null;
                    if (is_string($value) && $value !== '' && !preg_match('/[\r\n]/', $value)) {
                        cache_write('last_good_ping', $url, 3600);
                        return $value;
                    }
                }
            } catch (Throwable $ex) {
                $lastError = $ex->getMessage();
            }
        }
    }

    throw new RuntimeException($lastError);
}

function signature(bool $refresh = false): string {
    $value = cache_fetch_swr(
        'signature',
        SIGNATURE_TTL,
        SIGNATURE_STALE_TTL,
        fn () => fetch_signature_upstream(),
        $refresh,
        5
    );

    if (!is_string($value) || $value === '') {
        throw new RuntimeException('Geçersiz imza.');
    }
    return $value;
}

function get_saved_profile(): ?array {
    $p = cache_read('last_good_profile', 21600);
    if (
        is_array($p)
        && !empty($p['domain'])
        && in_array($p['domain'], UPSTREAM_DOMAINS, true)
        && !empty($p['ua'])
        && in_array($p['ua'], API_USER_AGENTS, true)
    ) {
        return [
            'domain' => $p['domain'],
            'play_path' => (!empty($p['play_path']) && in_array($p['play_path'], PLAY_PATHS, true))
                ? $p['play_path']
                : PLAY_PATHS[0],
            'ua' => $p['ua'],
        ];
    }
    return null;
}

function save_working_profile(string $domain, string $playPath, string $ua): void {
    cache_write('last_good_profile', [
        'domain' => $domain,
        'play_path' => $playPath,
        'ua' => $ua,
    ], 21600);
}

function active_upstream_domain(): string {
    $p = get_saved_profile();
    return $p['domain'] ?? UPSTREAM_DOMAINS[0];
}

function api_single_call(string $endpoint, array $payload, string $ua, bool &$refreshedSig): array {
    $sig = signature(false);
    $res = post_json($endpoint, $payload, ['mediahubmx-signature: ' . $sig], null, $ua);

    if (
        !$refreshedSig
        && !is_cloudflare_challenge($res['status'], $res['body'], $res['headers'])
        && in_array($res['status'], [401, 403], true)
    ) {
        $refreshedSig = true;
        $sig = signature(true);
        $res = post_json($endpoint, $payload, ['mediahubmx-signature: ' . $sig], null, $ua);
    }

    return $res;
}

/* ---------------- Kanal Çözümleme ---------------- */
function find_stream(array $data): ?string {
    $items = [$data];
    foreach ($data as $value) {
        if (is_array($value)) {
            $items[] = $value;
        }
    }

    foreach ($items as $item) {
        foreach (['url', 'stream'] as $key) {
            $url = $item[$key] ?? null;
            if (is_string($url) && is_public_http_url($url)) {
                return $url;
            }
        }
    }
    return null;
}

function extract_token(string $url): ?string {
    $query = parse_url($url, PHP_URL_QUERY);
    if (!$query) {
        return null;
    }
    parse_str($query, $params);
    foreach (['token', 'sig', 'sign', 'auth', 'key'] as $key) {
        if (!empty($params[$key]) && is_string($params[$key])) {
            return $params[$key];
        }
    }
    return null;
}

function extract_expiry(string $url): ?int {
    $query = parse_url($url, PHP_URL_QUERY);
    if (!$query) {
        return null;
    }
    parse_str($query, $params);
    foreach (['exp', 'expires', 'expiry', 'expire', 'ttl'] as $key) {
        if (isset($params[$key]) && is_numeric($params[$key])) {
            $value = (int) $params[$key];
            return $value > 1000000000 ? $value : time() + $value;
        }
    }
    return null;
}

function resolve_channel_upstream(string $id): array {
    $saved = get_saved_profile();
    $domains = $saved ? array_values(array_unique(array_merge([$saved['domain']], UPSTREAM_DOMAINS))) : UPSTREAM_DOMAINS;
    $uas = $saved ? array_values(array_unique(array_merge([$saved['ua']], API_USER_AGENTS))) : API_USER_AGENTS;
    $playPaths = $saved ? array_values(array_unique(array_merge([$saved['play_path']], PLAY_PATHS))) : PLAY_PATHS;

    $refreshedSig = false;
    $lastError = 'Yayın adresi bulunamadı.';
    $blockedCombos = [];

    // İlk olarak kayıtlı çalışan profili doğrudan dene
    $candidates = [];
    if ($saved !== null) {
        $candidates[] = [$saved['domain'], $saved['ua'], $saved['play_path']];
    }
    foreach ($domains as $d) {
        foreach ($uas as $u) {
            foreach ($playPaths as $pp) {
                if ($saved !== null && $d === $saved['domain'] && $u === $saved['ua'] && $pp === $saved['play_path']) {
                    continue;
                }
                $candidates[] = [$d, $u, $pp];
            }
        }
    }

    foreach ($candidates as [$domain, $ua, $playPath]) {
        if (budget() < 2.5) {
            break;
        }
        $comboKey = $domain . '|' . $ua;
        if (isset($blockedCombos[$comboKey])) {
            continue;
        }

        try {
            $res = api_single_call(
                $domain . '/mediahubmx-resolve.json',
                [
                    'language' => 'de',
                    'region' => 'AT',
                    'url' => $domain . $playPath . $id,
                    'clientVersion' => CLIENT_VERSION,
                ],
                $ua,
                $refreshedSig
            );

            if (is_cloudflare_challenge($res['status'], $res['body'], $res['headers'])) {
                $blockedCombos[$comboKey] = true;
                $lastError = 'Cloudflare koruması (' . parse_url($domain, PHP_URL_HOST) . ' / HTTP ' . $res['status'] . ')';
                continue;
            }

            if ($res['status'] < 200 || $res['status'] >= 300 || !is_array($res['json'])) {
                if ($res['status'] >= 400) {
                    $blockedCombos[$comboKey] = true;
                }
                $lastError = parse_url($domain, PHP_URL_HOST) . ' HTTP ' . $res['status'];
                continue;
            }

            $url = find_stream($res['json']);
            if ($url !== null) {
                save_working_profile($domain, $playPath, $ua);
                return [
                    'url' => $url,
                    'domain' => $domain,
                ];
            }
            $lastError = parse_url($domain, PHP_URL_HOST) . ' (' . $playPath . ') stream boş';
        } catch (Throwable $ex) {
            $blockedCombos[$comboKey] = true;
            $lastError = parse_url($domain, PHP_URL_HOST) . ': ' . $ex->getMessage();
        }
    }

    throw new RuntimeException($lastError);
}

function resolve_channel(string $id, ?string $rejectedUrl = null, bool $force = false): array {
    $cacheKey = 'stream_' . $id;
    $forceRefresh = $force;

    if (!$forceRefresh && $rejectedUrl !== null) {
        $current = cache_read_entry($cacheKey);
        if ($current !== null && is_array($current['v']) && ($current['v']['url'] ?? '') === $rejectedUrl) {
            $forceRefresh = true;
        }
    }

    $result = cache_fetch_swr(
        $cacheKey,
        RESOLVE_TTL_DEFAULT,
        RESOLVE_STALE_TTL,
        function () use ($id) {
            $resolved = resolve_channel_upstream($id);
            $url = $resolved['url'];
            $now = time();
            $expiry = extract_expiry($url);

            if ($expiry !== null && $expiry <= $now) {
                $dynamicTtl = 3;
                $effectiveExpiry = $now + 15;
            } elseif ($expiry !== null) {
                $lifetime = $expiry - $now;
                $lead = max(4, min(18, (int) floor($lifetime * 0.35)));
                $dynamicTtl = max(3, min(25, $lifetime - $lead));
                $effectiveExpiry = $expiry;
            } else {
                $dynamicTtl = RESOLVE_TTL_DEFAULT;
                $effectiveExpiry = $now + 40;
            }

            return [
                '__ttl' => $dynamicTtl,
                '__value' => [
                    'url' => $url,
                    'domain' => $resolved['domain'],
                    'token' => extract_token($url),
                    'expires_at' => $effectiveExpiry,
                    'refresh_seconds' => max(5, $effectiveExpiry - $now),
                ],
            ];
        },
        $forceRefresh,
        1
    );

    if (!is_array($result) || empty($result['url'])) {
        throw new RuntimeException('Yayın adresi çözümlenemedi.');
    }

    return $result;
}

/* ---------------- HLS Playlist, Varyant Haritası & Sarmalama ---------------- */
function normalize_url_path(string $path): string {
    $isDir = str_ends_with($path, '/');
    $segments = explode('/', $path);
    $stack = [];
    foreach ($segments as $seg) {
        if ($seg === '' || $seg === '.') {
            continue;
        }
        if ($seg === '..') {
            array_pop($stack);
            continue;
        }
        $stack[] = $seg;
    }
    $normalized = '/' . implode('/', $stack);
    if ($isDir && $normalized !== '/') {
        $normalized .= '/';
    }
    return $normalized;
}

function absolute_url(string $base, string $relative): string {
    if (preg_match('/^(https?:)?\/\//i', $relative)) {
        if (str_starts_with($relative, '//')) {
            $parts = parse_url($base);
            return ($parts['scheme'] ?? 'https') . ':' . $relative;
        }
        return $relative;
    }

    $parts = parse_url($base);
    if (
        !is_array($parts)
        || empty($parts['scheme'])
        || empty($parts['host'])
    ) {
        return $relative;
    }

    $root = $parts['scheme'] . '://'
        . $parts['host']
        . (isset($parts['port']) ? ':' . $parts['port'] : '');

    if (str_starts_with($relative, '?')) {
        $basePath = $parts['path'] ?? '/';
        return $root . $basePath . $relative;
    }

    if (str_starts_with($relative, '/')) {
        $qPos = strpos($relative, '?');
        if ($qPos !== false) {
            return $root . normalize_url_path(substr($relative, 0, $qPos)) . substr($relative, $qPos);
        }
        return $root . normalize_url_path($relative);
    }

    $basePath = $parts['path'] ?? '/';
    $lastSlash = strrpos($basePath, '/');
    $baseDir = $lastSlash !== false ? substr($basePath, 0, $lastSlash + 1) : '/';
    $qPos = strpos($relative, '?');
    $relPath = $qPos !== false ? substr($relative, 0, $qPos) : $relative;
    $relQuery = $qPos !== false ? substr($relative, $qPos) : '';

    return $root . normalize_url_path($baseDir . $relPath) . $relQuery;
}

function variant_key(string $url): string {
    $parts = parse_url($url);
    if (!is_array($parts)) {
        return $url;
    }
    $path = $parts['path'] ?? '/';
    $kept = [];

    if (!empty($parts['query'])) {
        parse_str($parts['query'], $params);
        $volatile = [
            'token', 'sig', 'sign', 'auth', 'key', 'exp', 'expires',
            'expiry', 'expire', 'ttl', 'hdnts', 'hdnea', 'wmsauthsign',
            't', '_t', 'hash', 'h', 'st', 'e',
        ];
        foreach ($params as $k => $v) {
            if (!in_array(strtolower((string) $k), $volatile, true)) {
                $kept[$k] = $v;
            }
        }
        ksort($kept);
    }

    return $path . ($kept !== [] ? '?' . http_build_query($kept) : '');
}

function hls_headers(?string $domain = null): array {
    $origin = $domain ?: active_upstream_domain();
    return [
        'User-Agent: ' . HLS_UA,
        'Accept: application/vnd.apple.mpegurl, application/x-mpegURL, */*',
        'Accept-Language: tr,tr;q=0.9,en;q=0.8',
        'Origin: ' . $origin,
        'Referer: ' . $origin . '/',
    ];
}

function parse_master_variants(string $masterPlaylist, string $baseUrl): array {
    $lines = preg_split('/\r\n|\r|\n/', $masterPlaylist) ?: [];
    $variants = [];
    $pendingInf = null;
    $idx = 0;

    foreach ($lines as $line) {
        $trimmed = trim($line);
        if ($trimmed === '') {
            continue;
        }

        if (str_starts_with($trimmed, '#EXT-X-MEDIA:')) {
            if (preg_match('/URI="([^"]+)"/', $trimmed, $m)) {
                $abs = absolute_url($baseUrl, $m[1]);
                if (looks_like_playlist_url($abs)) {
                    $vk = variant_key($abs);
                    $type = preg_match('/TYPE=([A-Z-]+)/', $trimmed, $tm) ? $tm[1] : 'MEDIA';
                    $group = preg_match('/GROUP-ID="([^"]+)"/', $trimmed, $gm) ? $gm[1] : '';
                    $lang = preg_match('/LANGUAGE="([^"]+)"/', $trimmed, $lm) ? $lm[1] : '';
                    $variants[$vk] = [
                        'url' => $abs,
                        'idx' => $idx++,
                        'kind' => 'media',
                        'bw' => 0,
                        'res' => $type . ':' . $group . ':' . $lang,
                        'path' => (string) (parse_url($abs, PHP_URL_PATH) ?? ''),
                    ];
                }
            }
            continue;
        }

        if (str_starts_with($trimmed, '#EXT-X-STREAM-INF:')) {
            $bw = preg_match('/BANDWIDTH=(\d+)/', $trimmed, $bm) ? (int) $bm[1] : 0;
            $res = preg_match('/RESOLUTION=(\d+x\d+)/', $trimmed, $rm) ? $rm[1] : '';
            $pendingInf = ['bw' => $bw, 'res' => $res];
            continue;
        }

        if (str_starts_with($trimmed, '#')) {
            continue;
        }

        if ($pendingInf !== null || looks_like_playlist_url($trimmed)) {
            $abs = absolute_url($baseUrl, $trimmed);
            $vk = variant_key($abs);
            $variants[$vk] = [
                'url' => $abs,
                'idx' => $idx++,
                'kind' => 'video',
                'bw' => $pendingInf['bw'] ?? 0,
                'res' => $pendingInf['res'] ?? '',
                'path' => (string) (parse_url($abs, PHP_URL_PATH) ?? ''),
            ];
            $pendingInf = null;
        }
    }

    return $variants;
}

function store_variant_map(string $id, string $masterUrl, string $masterBody, string $finalMasterUrl): array {
    $variants = parse_master_variants($masterBody, $finalMasterUrl);
    if ($variants === []) {
        return [];
    }
    $map = [
        'master_url' => $masterUrl,
        'final_master_url' => $finalMasterUrl,
        'updated_at' => time(),
        'variants' => $variants,
    ];
    cache_write('vmap_' . $id, $map, 180);
    return $map;
}

function match_variant_in_map(array $variants, string $oldSubUrl, ?array $previousMeta = null): ?string {
    if ($variants === []) {
        return null;
    }

    $vk = variant_key($oldSubUrl);
    if (isset($variants[$vk]['url'])) {
        return $variants[$vk]['url'];
    }

    $oldPath = (string) (parse_url($oldSubUrl, PHP_URL_PATH) ?? '');
    $oldTail = basename($oldPath);

    $bestUrl = null;
    $bestScore = -1;

    foreach ($variants as $v) {
        $score = 0;
        if ($oldTail !== '' && basename($v['path']) === $oldTail) {
            $score += 5;
        }
        if ($previousMeta !== null) {
            if (($previousMeta['kind'] ?? '') === $v['kind']) {
                $score += 3;
            }
            if (!empty($previousMeta['res']) && $previousMeta['res'] === $v['res']) {
                $score += 10;
            }
            if (!empty($previousMeta['bw']) && $previousMeta['bw'] === $v['bw']) {
                $score += 8;
            }
            if (isset($previousMeta['idx']) && $previousMeta['idx'] === $v['idx']) {
                $score += 4;
            }
        }
        if ($score > $bestScore) {
            $bestScore = $score;
            $bestUrl = $v['url'];
        }
    }

    if ($bestUrl !== null && $bestScore > 0) {
        return $bestUrl;
    }

    $first = reset($variants);
    return is_array($first) ? ($first['url'] ?? null) : null;
}

function wrap_sub_playlist_url(string $id, string $absoluteSubUrl): string {
    if (defined('MASKED_LIVE_URL')) {
        return MASKED_LIVE_URL
            . '?sub=' . rawurlencode($absoluteSubUrl)
            . '&sig=' . sign_sub_url($id, $absoluteSubUrl);
    }

    return BASE_URL
        . '?p=live&id=' . rawurlencode($id)
        . '&sub=' . rawurlencode($absoluteSubUrl)
        . '&sig=' . sign_sub_url($id, $absoluteSubUrl)
        . auth_query_suffix();
}

function looks_like_playlist_url(string $url): bool {
    $path = strtolower((string) (parse_url($url, PHP_URL_PATH) ?? ''));
    return str_ends_with($path, '.m3u8') || str_ends_with($path, '.m3u');
}

function rewrite_hls_playlist(string $playlist, string $finalUrl, string $id): string {
    $lines = preg_split('/\r\n|\r|\n/', $playlist) ?: [];
    $nextIsVariantPlaylist = false;

    foreach ($lines as $i => $line) {
        $trimmed = trim($line);
        if ($trimmed === '') {
            continue;
        }

        if (str_starts_with($trimmed, '#')) {
            $isMediaTag = str_starts_with($trimmed, '#EXT-X-MEDIA:');
            if (str_starts_with($trimmed, '#EXT-X-STREAM-INF:')) {
                $nextIsVariantPlaylist = true;
            }

            $lines[$i] = preg_replace_callback(
                '/URI="([^"]+)"/',
                function ($m) use ($finalUrl, $id, $isMediaTag) {
                    $uri = $m[1];
                    if ($uri === '' || preg_match('/^(data|urn|skd):/i', $uri)) {
                        return $m[0];
                    }
                    $abs = absolute_url($finalUrl, $uri);
                    if ($isMediaTag && looks_like_playlist_url($abs)) {
                        return 'URI="' . wrap_sub_playlist_url($id, $abs) . '"';
                    }
                    return 'URI="' . $abs . '"';
                },
                $line
            ) ?? $line;
            continue;
        }

        if (preg_match('/^(data|urn|skd):/i', $trimmed)) {
            $nextIsVariantPlaylist = false;
            continue;
        }

        $abs = absolute_url($finalUrl, $trimmed);
        if ($nextIsVariantPlaylist || looks_like_playlist_url($abs)) {
            $lines[$i] = wrap_sub_playlist_url($id, $abs);
            $nextIsVariantPlaylist = false;
        } else {
            $lines[$i] = $abs;
        }
    }

    return implode("\n", $lines) . "\n";
}

function refresh_master_and_match_variant(string $id, string $oldSubUrl, ?array $previousMeta, bool $forceResolve): string {
    $stream = resolve_channel($id, null, $forceResolve);
    $masterUrl = $stream['url'];
    $headers = hls_headers($stream['domain'] ?? null);

    $masterRes = cache_fetch_swr(
        'master_' . $id . '_' . hash('sha256', $masterUrl),
        10,
        30,
        function () use ($id, $masterUrl, $headers) {
            $res = get_text($masterUrl, $headers);
            if ($res['status'] < 200 || $res['status'] >= 300) {
                throw new RuntimeException('Master playlist alınamadı. HTTP ' . $res['status']);
            }
            $final = $res['final_url'] ?: $masterUrl;
            $map = store_variant_map($id, $masterUrl, $res['body'], $final);
            return [
                'body' => $res['body'],
                'final_url' => $final,
                'map' => $map,
            ];
        },
        $forceResolve,
        1
    );

    if (!is_array($masterRes)) {
        throw new RuntimeException('Master playlist çözümlenemedi.');
    }

    $variants = $masterRes['map']['variants'] ?? [];
    if ($variants !== []) {
        $matched = match_variant_in_map($variants, $oldSubUrl, $previousMeta);
        if ($matched !== null) {
            return $matched;
        }
    }

    return $masterUrl;
}

function fetch_upstream_playlist(string $id, ?string $subUrl = null): string {
    if ($subUrl !== null) {
        $stream = resolve_channel($id);
        $headers = hls_headers($stream['domain'] ?? null);
        $vmap = cache_read('vmap_' . $id, 180);
        $oldVk = variant_key($subUrl);
        $previousMeta = is_array($vmap) ? ($vmap['variants'][$oldVk] ?? null) : null;

        $targetSubUrl = $subUrl;
        if (is_array($vmap) && ($vmap['master_url'] ?? '') !== $stream['url']) {
            $targetSubUrl = refresh_master_and_match_variant($id, $subUrl, $previousMeta, false);
        } elseif (is_array($vmap) && isset($vmap['variants'][$oldVk]['url'])) {
            $targetSubUrl = $vmap['variants'][$oldVk]['url'];
        }

        $response = get_text($targetSubUrl, $headers);
        if ($response['status'] >= 200 && $response['status'] < 300) {
            return rewrite_hls_playlist(
                $response['body'],
                $response['final_url'] ?: $targetSubUrl,
                $id
            );
        }

        if (in_array($response['status'], [401, 403, 404, 410], true)) {
            $freshVariantUrl = refresh_master_and_match_variant($id, $subUrl, $previousMeta, true);
            $streamAfter = resolve_channel($id);
            $fallback = get_text($freshVariantUrl, hls_headers($streamAfter['domain'] ?? null));
            if ($fallback['status'] >= 200 && $fallback['status'] < 300) {
                return rewrite_hls_playlist(
                    $fallback['body'],
                    $fallback['final_url'] ?: $freshVariantUrl,
                    $id
                );
            }
        }

        throw new RuntimeException('Alt playlist alınamadı. HTTP ' . $response['status']);
    }

    $result = resolve_channel($id);
    $upstream = $result['url'];
    $headers = hls_headers($result['domain'] ?? null);
    $response = get_text($upstream, $headers);

    if (in_array($response['status'], [401, 403, 404, 410], true)) {
        $result = resolve_channel($id, $upstream, true);
        $upstream = $result['url'];
        $headers = hls_headers($result['domain'] ?? null);
        $response = get_text($upstream, $headers);
    }

    if ($response['status'] < 200 || $response['status'] >= 300) {
        throw new RuntimeException('Playlist alınamadı. HTTP ' . $response['status']);
    }

    $finalUrl = $response['final_url'] ?: $upstream;
    if (str_contains($response['body'], '#EXT-X-STREAM-INF:')) {
        store_variant_map($id, $upstream, $response['body'], $finalUrl);
    }

    return rewrite_hls_playlist($response['body'], $finalUrl, $id);
}

function live_playlist(string $id, ?string $subUrl = null): never {
    $prefix = defined('MASKED_LIVE_URL')
        ? 'plm_' . hash('sha256', (string) MASKED_LIVE_URL) . '_'
        : 'pl_';

    $cacheKey = $subUrl === null
        ? $prefix . $id
        : $prefix . $id . '_' . hash('sha256', variant_key($subUrl));

    $playlist = cache_fetch_swr(
        $cacheKey,
        PLAYLIST_TTL,
        PLAYLIST_STALE_TTL,
        fn () => fetch_upstream_playlist($id, $subUrl)
    );

    if (!is_string($playlist) || $playlist === '') {
        fail(502, 'Boş playlist yanıtı.');
    }

    send_compressed(
        $playlist,
        'application/vnd.apple.mpegurl; charset=utf-8',
        ['Access-Control-Allow-Origin: *']
    );
}

/* ---------------- Katalog & M3U ---------------- */
function m3u_text(string $value): string {
    return trim(str_replace(
        ["\r", "\n", '"'],
        [' ', ' ', "'"],
        $value
    ));
}

function parse_catalog_items(array $items, string $group, array &$channels): void {
    foreach ($items as $item) {
        if (!is_array($item)) {
            continue;
        }

        $ids = is_array($item['ids'] ?? null) ? $item['ids'] : [];
        $images = is_array($item['images'] ?? null) ? $item['images'] : [];
        $id = $ids['id'] ?? $item['id'] ?? '';

        if (!is_scalar($id) || !preg_match(ID_PATTERN, (string) $id)) {
            continue;
        }

        $name = $item['name'] ?? '';
        $logo = $images['logo'] ?? $images['poster'] ?? $item['logo'] ?? '';
        $tvg = $ids['tvg'] ?? '';

        $id = (string) $id;
        $channels[$id] = [
            'id' => $id,
            'name' => is_string($name) && $name !== '' ? $name : 'Kanal ' . $id,
            'group' => is_string($item['group'] ?? null) && $item['group'] !== '' ? $item['group'] : $group,
            'logo' => is_string($logo) && is_public_http_url($logo) ? $logo : '',
            'tvg' => is_scalar($tvg) ? (string) $tvg : '',
        ];
    }
}

function discover_catalog_profile(): array {
    $saved = get_saved_profile();
    $domains = $saved ? array_values(array_unique(array_merge([$saved['domain']], UPSTREAM_DOMAINS))) : UPSTREAM_DOMAINS;
    $uas = $saved ? array_values(array_unique(array_merge([$saved['ua']], API_USER_AGENTS))) : API_USER_AGENTS;
    $refreshedSig = false;
    $lastError = 'Katalog kaynağına ulaşılamadı.';

    foreach ($domains as $domain) {
        foreach ($uas as $ua) {
            if (budget() < 2.5) {
                break 2;
            }
            try {
                $res = api_single_call(
                    $domain . '/mediahubmx-catalog.json',
                    [
                        'language' => 'de',
                        'region' => 'AT',
                        'catalogId' => 'iptv',
                        'id' => 'iptv',
                        'adult' => false,
                        'search' => '',
                        'sort' => 'name',
                        'filter' => ['group' => 'Turkey'],
                        'cursor' => 0,
                        'clientVersion' => CLIENT_VERSION,
                    ],
                    $ua,
                    $refreshedSig
                );

                if (is_cloudflare_challenge($res['status'], $res['body'], $res['headers'])) {
                    $lastError = 'Cloudflare koruması (' . parse_url($domain, PHP_URL_HOST) . ')';
                    continue;
                }
                if ($res['status'] >= 200 && $res['status'] < 300 && is_array($res['json']) && is_array($res['json']['items'] ?? null)) {
                    save_working_profile($domain, $saved['play_path'] ?? PLAY_PATHS[0], $ua);
                    return ['domain' => $domain, 'ua' => $ua];
                }
                $lastError = parse_url($domain, PHP_URL_HOST) . ' HTTP ' . $res['status'];
            } catch (Throwable $ex) {
                $lastError = $ex->getMessage();
            }
        }
    }

    throw new RuntimeException($lastError);
}

function fetch_catalog_single(string $group): array {
    $profile = discover_catalog_profile();
    $domain = $profile['domain'];
    $ua = $profile['ua'];
    $refreshedSig = false;

    $cursor = 0;
    $seen = [];
    $channels = [];
    $finished = false;

    for ($page = 0; $page < 15; $page++) {
        $res = api_single_call(
            $domain . '/mediahubmx-catalog.json',
            [
                'language' => 'de',
                'region' => 'AT',
                'catalogId' => 'iptv',
                'id' => 'iptv',
                'adult' => false,
                'search' => '',
                'sort' => 'name',
                'filter' => ['group' => $group],
                'cursor' => $cursor,
                'clientVersion' => CLIENT_VERSION,
            ],
            $ua,
            $refreshedSig
        );

        if ($res['status'] < 200 || $res['status'] >= 300 || !is_array($res['json'])) {
            throw new RuntimeException('Katalog HTTP ' . $res['status']);
        }

        $items = $res['json']['items'] ?? null;
        if (!is_array($items)) {
            throw new RuntimeException('Katalog items yok.');
        }

        if ($items === []) {
            $finished = true;
            break;
        }

        parse_catalog_items($items, $group, $channels);

        $next = $res['json']['nextCursor'] ?? null;
        if ($next === null || $next === '' || $next === 0 || $next === false) {
            $finished = true;
            break;
        }

        $marker = json_encode($next);
        if (isset($seen[$marker])) {
            throw new RuntimeException('Katalog sayfalama döngüsü.');
        }
        $seen[$marker] = true;
        $cursor = $next;
    }

    if (!$finished) {
        throw new RuntimeException('Katalog 15 sayfa sınırını aştı.');
    }

    return array_values($channels);
}

function catalog(string $group): array {
    $data = cache_fetch_swr(
        'catalog-' . $group,
        CATALOG_TTL,
        CATALOG_STALE_TTL,
        fn () => fetch_catalog_single($group)
    );
    return is_array($data) ? $data : [];
}

function catalog_many(array $groups, bool $forceRefresh = false): array {
    $result = [];
    $missing = [];

    foreach ($groups as $group) {
        $cached = $forceRefresh ? null : cache_read('catalog-' . $group, CATALOG_TTL);
        if (is_array($cached) && $cached !== []) {
            $result[$group] = $cached;
        } else {
            $missing[$group] = [
                'cursor' => 0,
                'seen' => [],
                'channels' => [],
                'finished' => false,
            ];
        }
    }

    if ($missing === []) {
        return $result;
    }

    $profile = discover_catalog_profile();
    $catalogUrl = $profile['domain'] . '/mediahubmx-catalog.json';
    $ua = $profile['ua'];

    $sig = signature(false);
    $retriedAuth = false;

    for ($page = 0; $page < 15 && $missing !== []; $page++) {
        $batch = [];
        foreach ($missing as $group => $state) {
            $batch[$group] = [
                'url' => $catalogUrl,
                'ua' => $ua,
                'headers' => ['mediahubmx-signature: ' . $sig],
                'payload' => [
                    'language' => 'de',
                    'region' => 'AT',
                    'catalogId' => 'iptv',
                    'id' => 'iptv',
                    'adult' => false,
                    'search' => '',
                    'sort' => 'name',
                    'filter' => ['group' => $group],
                    'cursor' => $state['cursor'],
                    'clientVersion' => CLIENT_VERSION,
                ],
            ];
        }

        $responses = post_json_multi($batch);

        $needAuthRetry = false;
        if (!$retriedAuth) {
            foreach ($responses as $res) {
                if (in_array($res['status'], [401, 403], true) && !is_cloudflare_challenge($res['status'], $res['body'] ?? '')) {
                    $needAuthRetry = true;
                    break;
                }
            }
        }

        if ($needAuthRetry) {
            $retriedAuth = true;
            $sig = signature(true);
            foreach ($batch as $group => $req) {
                $batch[$group]['headers'] = ['mediahubmx-signature: ' . $sig];
            }
            $responses = post_json_multi($batch);
        }

        foreach ($responses as $group => $res) {
            if ($res['status'] < 200 || $res['status'] >= 300 || !is_array($res['json'])) {
                $stale = cache_read_entry('catalog-' . $group);
                $result[$group] = ($stale !== null && is_array($stale['v'])) ? $stale['v'] : [];
                unset($missing[$group]);
                continue;
            }

            $items = $res['json']['items'] ?? null;
            if (!is_array($items) || $items === []) {
                $channels = array_values($missing[$group]['channels']);
                if ($channels !== []) {
                    cache_write('catalog-' . $group, $channels);
                }
                $result[$group] = $channels;
                unset($missing[$group]);
                continue;
            }

            parse_catalog_items($items, $group, $missing[$group]['channels']);

            $next = $res['json']['nextCursor'] ?? null;
            $marker = json_encode($next);

            if (
                $next === null
                || $next === ''
                || $next === 0
                || $next === false
                || isset($missing[$group]['seen'][$marker])
            ) {
                $channels = array_values($missing[$group]['channels']);
                if ($channels !== []) {
                    cache_write('catalog-' . $group, $channels);
                }
                $result[$group] = $channels;
                unset($missing[$group]);
                continue;
            }

            $missing[$group]['seen'][$marker] = true;
            $missing[$group]['cursor'] = $next;
        }
    }

    foreach ($missing as $group => $state) {
        $channels = array_values($state['channels']);
        if ($channels !== []) {
            cache_write('catalog-' . $group, $channels);
        }
        $result[$group] = $channels;
    }

    return $result;
}

if (!function_exists('build_m3u')) {
    function build_m3u(array $channels): string {
        usort($channels, static fn ($a, $b) => strnatcasecmp($a['name'], $b['name']));

        $lines = ['#EXTM3U'];
        $suffix = auth_query_suffix();

        foreach ($channels as $channel) {
            $lines[] = '#EXTINF:-1'
                . ' tvg-id="' . m3u_text($channel['tvg']) . '"'
                . ' tvg-name="' . m3u_text($channel['name']) . '"'
                . ' tvg-logo="' . m3u_text($channel['logo']) . '"'
                . ' group-title="' . m3u_text($channel['group']) . '",'
                . m3u_text($channel['name']);
            $lines[] = BASE_URL . '?p=live&id=' . rawurlencode($channel['id']) . $suffix;
        }

        return implode("\n", $lines) . "\n";
    }
}

/* ---------------- Teşhis (Diagnostics) ---------------- */
function run_diagnostics(?string $testId = null): array {
    $curlVer = function_exists('curl_version') ? (curl_version()['version'] ?? 'unknown') : 'missing';
    $pingReport = [];
    $sigValue = null;
    $pingPayload = build_ping_payload();

    foreach (PING_URLS as $url) {
        $t0 = microtime(true);
        try {
            $res = post_json($url, $pingPayload, [], 4, API_USER_AGENTS[0]);
            $hasSig = false;
            if (is_array($res['json'])) {
                foreach (['sig', 'addonSig', 'signature', 'token'] as $k) {
                    if (!empty($res['json'][$k]) && is_string($res['json'][$k])) {
                        $hasSig = true;
                        if ($sigValue === null) {
                            $sigValue = $res['json'][$k];
                        }
                        break;
                    }
                }
            }
            $pingReport[] = [
                'url' => $url,
                'status' => $res['status'],
                'sig_ok' => $hasSig,
                'cloudflare' => is_cloudflare_challenge($res['status'], $res['body'], $res['headers']),
                'ms' => (int) round((microtime(true) - $t0) * 1000),
            ];
        } catch (Throwable $ex) {
            $pingReport[] = [
                'url' => $url,
                'status' => 0,
                'sig_ok' => false,
                'error' => $ex->getMessage(),
                'ms' => (int) round((microtime(true) - $t0) * 1000),
            ];
        }
    }

    $domainReport = [];
    $testUas = [API_USER_AGENTS[0], 'VAVOO/2.6', UA];
    foreach (UPSTREAM_DOMAINS as $domain) {
        foreach ($testUas as $ua) {
            if (budget() < 3.0) {
                break 2;
            }
            $t0 = microtime(true);
            try {
                $headers = $sigValue !== null ? ['mediahubmx-signature: ' . $sigValue] : [];
                $res = post_json(
                    $domain . '/mediahubmx-catalog.json',
                    [
                        'language' => 'de',
                        'region' => 'AT',
                        'catalogId' => 'iptv',
                        'id' => 'iptv',
                        'adult' => false,
                        'search' => 'TRT',
                        'sort' => 'name',
                        'filter' => ['group' => 'Turkey'],
                        'cursor' => 0,
                        'clientVersion' => CLIENT_VERSION,
                    ],
                    $headers,
                    5,
                    $ua
                );
                $cf = is_cloudflare_challenge($res['status'], $res['body'], $res['headers']);
                $itemsOk = is_array($res['json']) && is_array($res['json']['items'] ?? null);
                $domainReport[] = [
                    'domain' => $domain,
                    'ua' => $ua === UA ? 'Chrome' : $ua,
                    'status' => $res['status'],
                    'cloudflare_challenge' => $cf,
                    'json_items_ok' => $itemsOk,
                    'ms' => (int) round((microtime(true) - $t0) * 1000),
                ];
                if ($itemsOk) {
                    break;
                }
            } catch (Throwable $ex) {
                $domainReport[] = [
                    'domain' => $domain,
                    'ua' => $ua === UA ? 'Chrome' : $ua,
                    'status' => 0,
                    'error' => $ex->getMessage(),
                    'ms' => (int) round((microtime(true) - $t0) * 1000),
                ];
            }
        }
    }

    $channelReport = null;
    if ($testId !== null && preg_match(ID_PATTERN, $testId)) {
        try {
            $stream = resolve_channel($testId, null, true);
            $pl = get_text($stream['url'], hls_headers($stream['domain'] ?? null));
            $channelReport = [
                'id' => $testId,
                'ok' => $pl['status'] >= 200 && $pl['status'] < 300,
                'domain' => $stream['domain'] ?? null,
                'playlist_status' => $pl['status'],
                'is_m3u8' => str_contains($pl['body'], '#EXTM3U'),
            ];
        } catch (Throwable $ex) {
            $channelReport = [
                'id' => $testId,
                'ok' => false,
                'error' => $ex->getMessage(),
            ];
        }
    }

    return [
        'version' => STREAM_LIB_VERSION,
        'php' => PHP_VERSION,
        'curl' => $curlVer,
        'proxy_configured' => UPSTREAM_PROXY !== '',
        'cache_writable' => cache_dir() !== null,
        'saved_profile' => get_saved_profile(),
        'ping' => $pingReport,
        'domains' => $domainReport,
        'channel_test' => $channelReport,
    ];
}

