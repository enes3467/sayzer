    $jsPt = json_encode($playerToken, JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR);
    $titleId = e($id);

    return <<<HTML
<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Canlı Yayın — {$titleId}</title>
