/* ---------------- Yardımcılar ---------------- */
function fail(int $status, string $message, array $extraHeaders = []): never {
    http_response_code($status);
    header('Content-Type: text/plain; charset=utf-8');
    header('Cache-Control: no-store, no-cache, must-revalidate');
    foreach ($extraHeaders as $h) {
        header($h);
    }
    echo $message;
    exit;
}

function send_compressed(string $body, string $contentType, array $extraHeaders = []): never {
    http_response_code(200);
    header('Content-Type: ' . $contentType);
    header('Cache-Control: no-store, no-cache, must-revalidate');
    foreach ($extraHeaders as $h) {
        header($h);
    }

    $acceptEncoding = (string) ($_SERVER['HTTP_ACCEPT_ENCODING'] ?? '');
    if (
        strlen($body) >= 256
        && str_contains(strtolower($acceptEncoding), 'gzip')
        && function_exists('gzencode')
        && !ini_get('zlib.output_compression')
    ) {
        $gz = @gzencode($body, 5);
        if (is_string($gz)) {
            header('Content-Encoding: gzip');
            header('Vary: Accept-Encoding');
            header('Content-Length: ' . strlen($gz));
            echo $gz;
            exit;
        }
    }

    header('Content-Length: ' . strlen($body));
    echo $body;
    exit;
}

function json_out(array $data, int $status = 200): never {
    $json = json_encode(
        $data,
        JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE
    );

    if ($status === 200 && is_string($json)) {
        send_compressed($json, 'application/json; charset=utf-8');
    }

    http_response_code($status);
    header('Content-Type: application/json; charset=utf-8');
    header('Cache-Control: no-store, no-cache, must-revalidate');
    echo is_string($json) ? $json : '{}';
    exit;
}

function html_out(string $html): never {
    send_compressed($html, 'text/html; charset=utf-8');
}

