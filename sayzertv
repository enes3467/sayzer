button{background:#1e293b;color:#e7edf7;border:1px solid #334155;border-radius:8px;padding:6px 12px;font-size:12px;cursor:pointer}
button:hover{background:#334155}
video{width:100%;max-width:1080px;border-radius:12px;background:#000;aspect-ratio:16/9}
#error{color:#f87171;margin-top:8px;font-size:13px;min-height:1em}
#status{color:#9ca3af;margin-top:4px;font-size:12px}
</style>
</head>
<body>
<div class="wrap">
  <div class="bar">
    <h1>Canlı Yayın</h1>
    <button id="unmuteBtn" type="button">Sesi Aç</button>
  </div>
  <video id="video" controls autoplay playsinline muted></video>
  <div id="status">Bağlanıyor...</div>
  <div id="error"></div>
</div>
<script src="https://cdn.jsdelivr.net/npm/hls.js@1/dist/hls.min.js"></script>
<script>
const BASE = {$jsBase};
const ID = {$jsId};
const PT = {$jsPt};
const video = document.getElementById('video');
const statusBox = document.getElementById('status');
const errorBox = document.getElementById('error');
const unmuteBtn = document.getElementById('unmuteBtn');

unmuteBtn.addEventListener('click', () => {
  video.muted = !video.muted;
  unmuteBtn.textContent = video.muted ? 'Sesi Aç' : 'Sesi Kapat';
});

function streamUrl() {
  let u = BASE + '?p=live&id=' + encodeURIComponent(ID);
  if (PT) u += '&pt=' + encodeURIComponent(PT);
  return u;
}

let hls = null;
let softRetry = 0;
let hardRetry = 0;
let retryTimer = null;
let lastProgressAt = Date.now();
let lastTime = -1;

function clearRetryTimer() {
  if (retryTimer) {
    clearTimeout(retryTimer);
    retryTimer = null;
  }
}

function scheduleRestart(delayMs) {
  clearRetryTimer();
  retryTimer = setTimeout(start, delayMs);
}

function start() {
  clearRetryTimer();
  errorBox.textContent = '';

  if (hls) {
    try { hls.destroy(); } catch (_) {}
    hls = null;
  }

  if (window.Hls && Hls.isSupported()) {
    hls = new Hls({
      liveSyncDurationCount: 3,
      liveMaxLatencyDurationCount: 10,
      maxBufferLength: 30,
      maxMaxBufferLength: 60,
      backBufferLength: 30,
      manifestLoadingTimeOut: 15000,
      manifestLoadingMaxRetry: 8,
      manifestLoadingRetryDelay: 1200,
      levelLoadingTimeOut: 15000,
      levelLoadingMaxRetry: 8,
      levelLoadingRetryDelay: 1200,
      fragLoadingTimeOut: 18000,
      fragLoadingMaxRetry: 8,
      fragLoadingRetryDelay: 1200,
      enableWorker: true
    });

    hls.loadSource(streamUrl());
    hls.attachMedia(video);

    hls.on(Hls.Events.MANIFEST_PARSED, () => {
      statusBox.textContent = '';
      softRetry = 0;
      hardRetry = 0;
      video.play().catch(() => {});
    });

    hls.on(Hls.Events.FRAG_BUFFERED, () => {
      statusBox.textContent = '';
      errorBox.textContent = '';
      softRetry = 0;
      hardRetry = 0;
      lastProgressAt = Date.now();
    });

    hls.on(Hls.Events.ERROR, (_, data) => {
      if (!data.fatal) return;

      if (data.type === Hls.ErrorTypes.NETWORK_ERROR) {
        softRetry++;
        if (softRetry <= 4) {
          statusBox.textContent = 'Bağlantı tazeleniyor...';
          setTimeout(() => {
            if (hls) hls.startLoad();
          }, 1200 * softRetry);
          return;
        }
      } else if (data.type === Hls.ErrorTypes.MEDIA_ERROR) {
        softRetry++;
        if (softRetry <= 2) {
          statusBox.textContent = 'Yayın toparlanıyor...';
          hls.recoverMediaError();
          return;
        }
      }

      hardRetry++;
      const delay = Math.min(15000, 1500 * Math.min(hardRetry, 6));
      statusBox.textContent = 'Yeniden bağlanıyor...';
      errorBox.textContent = 'Yayın geçici olarak kesildi, tekrar deneniyor.';
      scheduleRestart(delay);
    });

    setInterval(() => {
      if (video.paused || video.ended) return;
      if (video.currentTime !== lastTime) {
        lastTime = video.currentTime;
        lastProgressAt = Date.now();
      } else if (Date.now() - lastProgressAt > 35000) {
        lastProgressAt = Date.now();
        if (hls) {
          statusBox.textContent = 'Akış senkronize ediliyor...';
          hls.startLoad();
        }
      }
    }, 5000);
  } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
    video.src = streamUrl();
    video.addEventListener('loadedmetadata', () => {
      statusBox.textContent = '';
      video.play().catch(() => {});
    }, { once: true });
    video.addEventListener('error', () => {
      hardRetry++;
      const delay = Math.min(15000, 1500 * Math.min(hardRetry, 6));
      statusBox.textContent = 'Yeniden bağlanıyor...';
      clearRetryTimer();
      retryTimer = setTimeout(() => {
        video.src = streamUrl() + '&_t=' + Date.now();
        video.load();
      }, delay);
    });
  } else {
    errorBox.textContent = 'Tarayıcınız HLS oynatmayı desteklemiyor.';
  }
}

window.addEventListener('online', () => {
  if (hls) hls.startLoad();
});
document.addEventListener('visibilitychange', () => {
  if (!document.hidden && hls && video.paused === false) {
    hls.startLoad();
  }
});

start();
</script>
</body>
</html>
HTML;
}

/* ---------------- Main ---------------- */
if (!defined('STREAM_AS_LIBRARY')) {
    if (param('p') === '' && !isset($_GET['list']) && !isset($_GET['go'])) {
        $reqPath = !empty($_SERVER['PATH_INFO']) && is_string($_SERVER['PATH_INFO'])
            ? $_SERVER['PATH_INFO']
            : (string) (parse_url((string) ($_SERVER['REQUEST_URI'] ?? ''), PHP_URL_PATH) ?? '');
        $scriptDir = rtrim(str_replace('\\', '/', dirname((string) ($_SERVER['SCRIPT_NAME'] ?? '/'))), '/');
        if ($scriptDir !== '' && str_starts_with($reqPath, $scriptDir . '/')) {
            $reqPath = substr($reqPath, strlen($scriptDir));
        }
        $candidateSlug = trim($reqPath, '/');

        if (str_ends_with(strtolower($candidateSlug), '.m3u') && is_file(__DIR__ . '/m3u.php')) {
            $m3uSlug = substr($candidateSlug, 0, -4);
            if (preg_match('/^[A-Za-z0-9_-]{1,64}$/', $m3uSlug)) {
                $_GET['slug'] = $m3uSlug;
                require __DIR__ . '/m3u.php';
                exit;
            }
        }

        if (is_file(__DIR__ . '/panel.php')) {
            $cleanSlug = str_ends_with(strtolower($candidateSlug), '.m3u8')
                ? substr($candidateSlug, 0, -5)
                : $candidateSlug;
            if (
                $candidateSlug !== ''
                && !str_ends_with(strtolower($candidateSlug), '.php')
                && !is_file(__DIR__ . '/' . $candidateSlug)
                && preg_match('/^[A-Za-z0-9._-]{1,64}$/', $cleanSlug)
            ) {
                define('STREAM_AS_LIBRARY', true);
                $_GET['go'] = $candidateSlug;
                require __DIR__ . '/panel.php';
                exit;
            }
        }
    }

    try {
        if (!extension_loaded('curl')) {
            fail(500, 'cURL etkin değil.');
        }

        $page = param('p');
        $id = param('id');

        if (ACCESS_KEY !== '') {
            $providedKey = param('key');
            $playerTok = param('pt');
            $validKey = hash_equals(ACCESS_KEY, $providedKey);
            $validPlayerToken = ($page === 'live' && preg_match(ID_PATTERN, $id) && verify_player_token($id, $playerTok));

            if (!$validKey && !$validPlayerToken) {
                fail(403, 'Erişim reddedildi.');
            }
        }

        cache_gc();

        if ($page === 'diag') {
            json_out(run_diagnostics($id !== '' ? $id : null));
        }

        if ($page === 'player') {
            if (!preg_match(ID_PATTERN, $id)) {
                fail(400, 'Geçersiz kanal kimliği.');
            }
            html_out(render_player($id));
        }

        if ($page === 'live') {
            if (!preg_match(ID_PATTERN, $id)) {
                fail(400, 'Geçersiz kanal kimliği.');
            }
            $subUrl = null;
            $rawSub = param('sub');
            if ($rawSub !== '') {
                $sig = param('sig');
                $expectedSig = sign_sub_url($id, $rawSub);
                if (!hash_equals($expectedSig, $sig) || !is_public_http_url($rawSub)) {
                    fail(403, 'Geçersiz alt playlist imzası.');
                }
                $subUrl = $rawSub;
            }
            live_playlist($id, $subUrl);
        }

        if ($page === 'token') {
            if (!preg_match(ID_PATTERN, $id)) {
                fail(400, 'Geçersiz kanal kimliği.');
            }
            $result = resolve_channel($id);
            json_out([
                'ok' => true,
                'id' => $id,
                'domain' => $result['domain'] ?? null,
                'token' => $result['token'],
                'expires_at' => $result['expires_at'],
                'refresh_seconds' => $result['refresh_seconds'],
                'stream_url' => $result['url'],
            ]);
        }

        if (isset($_GET['list'])) {
            $group = preg_replace('/\.m3u$/i', '', trim(param('list')));

            if ($group === '' || strcasecmp($group, 'all') === 0) {
                $m3u = cache_fetch_swr(
                    'm3u_all_' . hash('sha256', BASE_URL . ACCESS_KEY),
                    CATALOG_TTL,
                    CATALOG_STALE_TTL,
                    function (): string {
                        $byGroup = catalog_many(GROUPS);
                        $channels = [];
                        foreach (GROUPS as $name) {
                            foreach ($byGroup[$name] ?? [] as $channel) {
                                $channels[$channel['id']] = $channel;
                            }
                        }
                        $channels = array_values($channels);
                        if ($channels === []) {
                            throw new RuntimeException('Kanal bulunamadı.');
                        }
                        return build_m3u($channels);
                    }
                );
            } else {
                if (strlen($group) > 80 || preg_match('/[\x00-\x1f\x7f]/', $group)) {
                    fail(400, 'Geçersiz grup.');
                }
                $m3u = cache_fetch_swr(
                    'm3u_' . $group . '_' . hash('sha256', BASE_URL . ACCESS_KEY),
                    CATALOG_TTL,
                    CATALOG_STALE_TTL,
                    function () use ($group): string {
                        $channels = catalog($group);
                        if ($channels === []) {
                            throw new RuntimeException('Kanal bulunamadı.');
                        }
                        return build_m3u($channels);
                    }
                );
            }

            if (!is_string($m3u) || $m3u === '') {
                fail(404, 'Kanal bulunamadı.');
            }

            send_compressed(
                $m3u,
                'audio/x-mpegurl; charset=utf-8',
                ['Content-Disposition: inline; filename="playlist.m3u"']
            );
        }

        if ($page === 'countries') {
            $summary = cache_fetch_swr(
                'countries_summary',
                CATALOG_TTL,
                CATALOG_STALE_TTL,
                function (): array {
                    $byGroup = catalog_many(GROUPS);
                    $counts = [];
                    foreach (GROUPS as $group) {
                        $counts[$group] = count($byGroup[$group] ?? []);
                    }
                    $total = array_sum($counts);
                    if ($total === 0) {
                        throw new RuntimeException('Ülke kataloğu boş.');
                    }
                    return [
                        'total' => $total,
                        'countries' => $counts,
                    ];
                }
            );
            json_out(is_array($summary) ? $summary : ['total' => 0, 'countries' => []]);
        }

        $suffix = auth_query_suffix();
        header('Content-Type: text/plain; charset=utf-8');
        echo "Düşük Kotalı & Çoklu Kaynaklı HLS API (v" . STREAM_LIB_VERSION . ")\n\n";
        echo "Player: " . BASE_URL . "?p=player&id=KANAL_ID" . $suffix . "\n";
        echo "HLS:    " . BASE_URL . "?p=live&id=KANAL_ID" . $suffix . "\n";
        echo "Token:  " . BASE_URL . "?p=token&id=KANAL_ID" . $suffix . "\n";
        echo "Teşhis: " . BASE_URL . "?p=diag" . $suffix . "\n";
        echo "M3U:    " . BASE_URL . "?list=Turkey.m3u" . $suffix . "\n";
    } catch (Throwable $ex) {
        error_log('HLS API: ' . $ex->getMessage());
        fail(503, 'Yayın geçici olarak alınamadı.', ['Retry-After: 2']);
    }
}
